# Sepolia Testnet Configuration
# Copy this file to .env and fill in your values
# NEVER commit the .env file to git

# Your Infura/Alchemy RPC URL for Sepolia testnet
# Example: https://sepolia.infura.io/v3/YOUR_INFURA_PROJECT_ID
SEPOLIA_RPC_URL=

# Private key of the deployer account (must have Sepolia ETH)
# DO NOT use your mainnet wallet! Use a testnet-only wallet
# Get free Sepolia ETH from: https://sepoliafaucet.com/
SEPOLIA_PRIVATE_KEY=

# Etherscan API key (optional, for contract verification)
ETHERSCAN_API_KEY=
